# Copy: cp config/.env.example config/.env
# Then: chmod 600 config/.env  &&  $EDITOR config/.env
# Encrypt: age -r <YOUR_AGE_PUBKEY> -o config/.env.age config/.env  (see SECURITY.md)
# NEVER commit config/.env — it is gitignored.

# ── Telegram ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Discord ─────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=

# ── WhatsApp ────────────────────────────────────────────────────────────
# Baileys uses QR, not token — leave empty. Session stored in data/whatsapp/
WHATSAPP_SESSION=

# ── Gmail OAuth ─────────────────────────────────────────────────────────
# Downloaded from Google Cloud Console → OAuth 2.0 Client ID (Desktop)
# File goes to data/gmail/credentials.json, not here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Social (optional, read-only) ───────────────────────────────────────
FB_PAGE_TOKEN=
X_BEARER_TOKEN=

# ── TradingView ─────────────────────────────────────────────────────────
TV_WEBHOOK_SECRET=change-me-to-a-random-32-char-string

# ── Binance ─────────────────────────────────────────────────────────────
# Create a READ-ONLY key first (no trading, no withdraw). See docs/09-tradingview-binance.md
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ── AI (only if you opt into cloud fallback) ────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Gateway ─────────────────────────────────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=change-me
